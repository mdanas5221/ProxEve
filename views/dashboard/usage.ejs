            </tbody>
          </table>
        </div>
      </section>

      <!-- ==================================================
             8. EMPTY STATE (INCLUDED FOR FUTURE USE, HIDDEN BY DEFAULT)
             ================================================== -->
      <section class="usage-empty-state" id="usage-empty-state" style="display: none;" aria-label="Empty Usage State">
        <div class="empty-icon-box" aria-hidden="true">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" x2="12" y1="20" y2="10"></line>
            <line x1="18" x2="18" y1="20" y2="4"></line>
            <line x1="6" x2="6" y1="20" y2="16"></line>
          </svg>
        </div>
        <h2 class="empty-title">No usage data yet</h2>
        <p class="empty-desc">
          Connect your application and start sending requests through ProxEve to see usage metrics here.
        </p>
        <a href="/#quickstart" class="btn-empty-quickstart" id="btn-empty-quickstart">
          <span>View Quickstart</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </section>
    </main>
  </div>

