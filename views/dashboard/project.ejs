<!doctype html>
<html lang="en">

<%- include('../partials/head.ejs') %>

</head>

<body class="dashboard-body">
  <div class="dash-mobile-backdrop" id="dash-mobile-backdrop" aria-hidden="true"></div>

  <%- include('../partials/sidebar.ejs') %>

  <div class="dash-main-container">
    <!-- Top Header Bar -->
    <header class="dash-header" id="dash-header">
      <div class="dash-header-left">
        <button type="button" class="dash-sidebar-toggle-btn" id="dash-sidebar-toggle-btn" aria-label="Toggle sidebar" title="Toggle sidebar (Ctrl+B)">
          <svg class="icon-collapse" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="18" height="18" x="3" y="3" rx="2"></rect>
            <path d="M9 3v18"></path>
            <path d="m14 9-3 3 3 3"></path>
          </svg>
          <svg class="icon-expand" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="18" height="18" x="3" y="3" rx="2"></rect>
            <path d="M9 3v18"></path>
            <path d="m11 9 3 3-3 3"></path>
          </svg>
        </button>
        <div class="dash-header-title-group">
          <h1 class="dash-header-heading">Projects</h1>
          <p class="dash-header-subtitle">Manage the applications connected to ProxEve.</p>
        </div>
      </div>

      <div class="dash-header-actions">
        <button type="button" class="btn-primary-action" id="btn-open-create-project">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
          </svg>
          <span>Create Project</span>
        </button>
        <!-- Mobile Hamburger Toggle (Right-aligned) -->
        <button class="dash-mobile-toggle" id="dash-mobile-toggle" aria-label="Toggle dashboard menu" aria-expanded="false">
          <span class="hamburger-box">
            <span class="hamburger-line line-1"></span>
            <span class="hamburger-line line-2"></span>
            <span class="hamburger-line line-3"></span>
          </span>
        </button>
      </div>
    </header>

    <!-- Main Dashboard Content -->
    <main class="dash-content">
      <!-- Toolbar & Demo Data indicator -->
      <section class="projects-toolbar" aria-label="Projects Filter and Status">
        <div class="toolbar-left">
          <span class="toolbar-title">Connected Projects <%= projects.length %></span>
        </div>
      </section>

      <!-- Mobile Section Large Action Button (Visible on mobile screens only) -->
      <div class="mobile-section-action-bar" id="projects-mobile-action-bar">
        <button type="button" class="btn-mobile-large-action" id="btn-mobile-create-project">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
          </svg>
          <span>Create Project</span>
        </button>
      </div>

      <!-- ==================================================
             PROJECT CARDS LIST
             ================================================== -->
      <section class="projects-grid" id="projects-grid" aria-label="List of Projects">

        <% if (projects.length === 0) { %>
        <section class="projects-empty-state" id="projects-empty-state" aria-label="Empty Projects State" style="width: 100%;">
          <div class="empty-state-icon-box" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"></path>
            </svg>
          </div>
          <h2 class="empty-state-title">No projects yet</h2>
          <p class="empty-state-desc">
            Create your first project to start routing AI requests through ProxEve.
          </p>
          <button type="button" class="btn-empty-create" id="btn-empty-create">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="12" y1="5" x2="12" y2="19"></line>
              <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            <span>Create Project</span>
          </button>
        </section>
        <% } else { %>
        <% projects.forEach(eve => { %>
        <article class="project-card" id="project-myquerytool">
          <div class="project-card-top">
            <div class="project-card-header">
              <div class="project-title-group">
                <h2 class="project-name"><%= eve.name %></h2>
                <span class="status-pill active">
                  <span class="status-dot"></span>
                  <span>Active</span>
                </span>
              </div>

              <!-- Three-Dot Menu -->
              <div class="menu-container">
                <button type="button" class="btn-three-dots" aria-label="Project actions" aria-haspopup="true">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="1.5"></circle>
                    <circle cx="12" cy="5" r="1.5"></circle>
                    <circle cx="12" cy="19" r="1.5"></circle>
                  </svg>
                </button>
                <div class="menu-dropdown" role="menu">
                  <button type="button" class="menu-item" role="menuitem">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path>
                      <circle cx="12" cy="12" r="3"></circle>
                    </svg>
                    <span>View</span>
                  </button>
                  <button type="button" class="menu-item danger" role="menuitem">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M3 6h18"></path>
                      <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path>
                      <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path>
                    </svg>
                    <span>Delete</span>
                  </button>
                </div>
              </div>
            </div>

            <p class="project-description">
              <%= eve.description %>
            </p>

            <!-- Provider Tag -->
            <div class="provider-tag-row">
              <span class="provider-tag">
                <span class="provider-dot gemini"></span>
                <span><%= eve.aiProvider %></span>
              </span>
            </div>
          </div>

          <!-- Metrics -->
          <div class="project-card-bottom">
            <div class="project-metrics-grid">
              <div class="project-metric-item">
                <span class="project-metric-label">Requests</span>
                <span class="project-metric-val">12,482</span>
              </div>
              <div class="project-metric-item">
                <span class="project-metric-label">Cache Hit Rate</span>
                <span class="project-metric-val">71.4%</span>
              </div>
            </div>

            <div class="project-activity-row">
              <svg class="project-activity-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
              <span>Last Activity: 2 minutes ago</span>
            </div>

            <div class="project-card-footer">
              <button type="button" class="btn-view-project" data-project="MyQueryTool">
                <span>View project</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14"></path>
                  <path d="m12 5 7 7-7 7"></path>
                </svg>
              </button>
            </div>
          </div>
        </article>
        <% }) %>
        <% } %>
      </section>

    </main>
  </div>

  <%- include('../partials/create-project.ejs') %>

  <%- include('../partials/toast-msg.ejs') %>

  <%- include('../partials/footer.ejs') %>
</body>

</html>