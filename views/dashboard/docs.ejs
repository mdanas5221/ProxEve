          <!-- 2. QUICKSTART -->
          <section id="quickstart" class="docs-section">
            <div class="docs-section-header">
              <span class="docs-section-tag">Getting Started</span>
              <h2 class="docs-h1">Quickstart</h2>
              <p class="docs-lead">Connect your application to ProxEve in a few simple steps.</p>
            </div>

            <!-- Steps 1 to 5 -->
            <div class="qs-steps-list">
              <div class="qs-step-card">
                <div class="qs-step-num">1</div>
                <div class="qs-step-content">
                  <h3 class="qs-step-title">Create a Project</h3>
                  <p class="qs-step-desc">Navigate to <a href="/project" style="color:#2563eb;text-decoration:underline;">Projects</a> and click <strong>Create Project</strong> to isolate your caching rules and metrics.</p>
                </div>
              </div>

              <div class="qs-step-card">
                <div class="qs-step-num">2</div>
                <div class="qs-step-content">
                  <h3 class="qs-step-title">Create a ProxEve API Key</h3>
                  <p class="qs-step-desc">Open the <a href="/api-key" style="color:#2563eb;text-decoration:underline;">API Keys tab</a> and generate an authentication key (e.g., <code class="code-inline">pk_live_...</code>).</p>
                </div>
              </div>

              <div class="qs-step-card">
                <div class="qs-step-num">3</div>
                <div class="qs-step-content">
                  <h3 class="qs-step-title">Configure your AI provider credentials</h3>
                  <p class="qs-step-desc">In your project settings, link your existing OpenAI, Google Gemini, or Anthropic API key so ProxEve can proxy misses securely.</p>
                </div>
              </div>

              <div class="qs-step-card">
                <div class="qs-step-num">4</div>
                <div class="qs-step-content">
                  <h3 class="qs-step-title">Change your application's API base URL</h3>
                  <p class="qs-step-desc">Switch your SDK base URL from <code class="code-inline">https://api.openai.com/v1</code> to the ProxEve gateway URL <code class="code-inline">https://api.proxeve.io/v1</code>.</p>
                </div>
              </div>

              <div class="qs-step-card">
                <div class="qs-step-num">5</div>
                <div class="qs-step-content">
                  <h3 class="qs-step-title">Send your first request</h3>
                  <p class="qs-step-desc">Dispatch any standard chat completion or embedding request. The first call populates the cache; identical subsequent calls resolve in milliseconds.</p>
                </div>
              </div>
            </div>

