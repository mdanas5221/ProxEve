<!doctype html>
<html lang="en">

<%- include('../partials/head.ejs') %>

<body class="dashboard-body">

  <div class="dash-mobile-backdrop" id="dash-mobile-backdrop" aria-hidden="true"></div>

  <%- include('../partials/sidebar.ejs') %>


  <div class="dash-main-container">
    <!-- Top Header Bar -->
    <header class="dash-header" id="dash-header">
      <div class="dash-header-left">
        <button type="button" class="dash-sidebar-toggle-btn" id="dash-sidebar-toggle-btn" aria-label="Toggle sidebar" title="Toggle sidebar (Ctrl+B)">
          <svg class="icon-collapse" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="18" height="18" x="3" y="3" rx="2"></rect>
            <path d="M9 3v18"></path>
            <path d="m14 9-3 3 3 3"></path>
          </svg>
          <svg class="icon-expand" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="18" height="18" x="3" y="3" rx="2"></rect>
            <path d="M9 3v18"></path>
            <path d="m11 9 3 3-3 3"></path>
          </svg>
        </button>
        <div class="dash-header-title-group">
          <h1 class="dash-header-heading">Overview</h1>
          <p class="dash-header-subtitle">Monitor your ProxEve usage and cache performance.</p>
        </div>
      </div>

      <div class="dash-header-actions">
        <!-- Mobile Hamburger Toggle (Right-aligned) -->
        <button class="dash-mobile-toggle" id="dash-mobile-toggle" aria-label="Toggle dashboard menu" aria-expanded="false">
          <span class="hamburger-box">
            <span class="hamburger-line line-1"></span>
            <span class="hamburger-line line-2"></span>
            <span class="hamburger-line line-3"></span>
          </span>
        </button>
      </div>
    </header>

    <!-- Main Dashboard Content -->
    <main class="dash-content">
      <!-- Prominent Onboarding / Connect Application Card -->
      <section class="setup-banner" id="onboarding-setup-card">
        <div class="setup-text-group">
          <div class="setup-title-row">
            <h2 class="setup-title">Connect your application</h2>
          </div>
          <p class="setup-description">
            Route your AI requests through ProxEve to start caching responses.
          </p>
        </div>
        <div class="setup-actions">
          <button type="button" class="btn-setup-primary" id="btn-create-key-banner">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="12" y1="5" x2="12" y2="19"></line>
              <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            <span>Create API Key</span>
          </button>
          <button type="button" class="btn-setup-secondary" id="btn-create-project-banner">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="12" y1="5" x2="12" y2="19"></line>
              <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            <span>Create Project</span>
          </button>
        </div>
      </section>

      <!-- Overview Metric Cards (4 Cards with Mock Data) -->
      <section class="metric-grid" aria-label="Key Usage Metrics">
        <!-- Card 1: Requests -->
        <div class="metric-card" id="metric-card-requests">
          <div class="metric-header">
            <span class="metric-label">Requests</span>
            <span class="metric-icon" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 14.899A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 2.5 8.242"></path>
                <path d="m8 17 4-4 4 4"></path>
                <path d="M12 13v9"></path>
              </svg>
            </span>
          </div>
          <div class="metric-value">24,821</div>
          <div class="metric-subtext">Last 30 days &bull; Total API requests</div>
        </div>

        <!-- Card 2: Cache Hits -->
        <div class="metric-card" id="metric-card-hits">
          <div class="metric-header">
            <span class="metric-label">Cache Hits</span>
            <span class="metric-icon" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: #059669;">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </span>
          </div>
          <div class="metric-value">18,403</div>
          <div class="metric-subtext">Last 30 days &bull; Served from cache</div>
        </div>

        <!-- Card 3: Cache Misses -->
        <div class="metric-card" id="metric-card-misses">
          <div class="metric-header">
            <span class="metric-label">Cache Misses</span>
            <span class="metric-icon" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: #d97706;">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
              </svg>
            </span>
          </div>
          <div class="metric-value">6,418</div>
          <div class="metric-subtext">Last 30 days &bull; Forwarded to AI provider</div>
        </div>

        <!-- Card 4: Cache Hit Rate -->
        <div class="metric-card" id="metric-card-hitrate">
          <div class="metric-header">
            <span class="metric-label">Cache Hit Rate</span>
            <span class="metric-icon" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--accent-blue);">
                <line x1="19" y1="5" x2="5" y2="19"></line>
                <circle cx="6.5" cy="6.5" r="2.5"></circle>
                <circle cx="17.5" cy="17.5" r="2.5"></circle>
              </svg>
            </span>
          </div>
          <div class="metric-value">74.1%</div>
          <div class="metric-subtext">Last 30 days &bull; Cache efficiency</div>
        </div>
      </section>

      <!-- Two-Column Grid: Cache Performance & API Keys -->
      <div class="dash-two-col">
        <!-- Cache Performance Section -->
        <section class="dash-panel" id="panel-cache-performance">
          <div class="dash-panel-header">
            <div class="panel-header-title-group">
              <h3 class="dash-panel-title">Cache Performance</h3>
              <span class="mock-badge"><span class="mock-badge-dot"></span>Mock data</span>
            </div>
            <span class="dash-panel-badge">Last 7 days</span>
          </div>

          <div class="chart-container">
            <!-- Legend Bar -->
            <div class="chart-legend-bar">
              <div class="chart-legends">
                <span class="legend-item" id="legend-hits">
                  <span class="legend-color-dot legend-dot-hits"></span>
                  <span>Cache Hits (18,403)</span>
                </span>
                <span class="legend-item" id="legend-misses">
                  <span class="legend-color-dot legend-dot-misses"></span>
                  <span>Cache Misses (6,418)</span>
                </span>
              </div>
              <span class="chart-total-count">24,821 total requests</span>
            </div>

            <!-- Interactive 7-Day Performance Chart -->
            <div class="chart-bars-wrap" id="performance-chart" aria-label="7-Day Cache Activity Chart">
              <!-- Mon: 1,840 (Hits: 1,360, Misses: 480) -->
              <div class="chart-col" data-day="Monday" data-total="1,840" data-hits="1,360" data-misses="480" data-rate="73.9%">
                <div class="chart-tooltip">
                  <strong>Monday</strong><br />
                  Total: 1,840<br />
                  Hits: 1,360 (73.9%)<br />
                  Misses: 480
                </div>
                <div class="chart-col-bars">
                  <div class="bar-stack" style="height: 45%;">
                    <div class="bar-segment-miss" style="height: 26%;"></div>
                    <div class="bar-segment-hit" style="height: 74%;"></div>
                  </div>
                </div>
                <span class="chart-col-label">Mon</span>
              </div>

              <!-- Tue: 2,210 (Hits: 1,650, Misses: 560) -->
              <div class="chart-col" data-day="Tuesday" data-total="2,210" data-hits="1,650" data-misses="560" data-rate="74.7%">
                <div class="chart-tooltip">
                  <strong>Tuesday</strong><br />
                  Total: 2,210<br />
                  Hits: 1,650 (74.7%)<br />
                  Misses: 560
                </div>
                <div class="chart-col-bars">
                  <div class="bar-stack" style="height: 55%;">
                    <div class="bar-segment-miss" style="height: 25%;"></div>
                    <div class="bar-segment-hit" style="height: 75%;"></div>
                  </div>
                </div>
                <span class="chart-col-label">Tue</span>
              </div>

              <!-- Wed: 3,120 (Hits: 2,340, Misses: 780) -->
              <div class="chart-col" data-day="Wednesday" data-total="3,120" data-hits="2,340" data-misses="780" data-rate="75.0%">
                <div class="chart-tooltip">
                  <strong>Wednesday</strong><br />
                  Total: 3,120<br />
                  Hits: 2,340 (75.0%)<br />
                  Misses: 780
                </div>
                <div class="chart-col-bars">
                  <div class="bar-stack" style="height: 78%;">
                    <div class="bar-segment-miss" style="height: 25%;"></div>
                    <div class="bar-segment-hit" style="height: 75%;"></div>
                  </div>
                </div>
                <span class="chart-col-label">Wed</span>
              </div>

              <!-- Thu: 2,760 (Hits: 2,070, Misses: 690) -->
              <div class="chart-col" data-day="Thursday" data-total="2,760" data-hits="2,070" data-misses="690" data-rate="75.0%">
                <div class="chart-tooltip">
                  <strong>Thursday</strong><br />
                  Total: 2,760<br />
                  Hits: 2,070 (75.0%)<br />
                  Misses: 690
                </div>
                <div class="chart-col-bars">
                  <div class="bar-stack" style="height: 69%;">
                    <div class="bar-segment-miss" style="height: 25%;"></div>
                    <div class="bar-segment-hit" style="height: 75%;"></div>
                  </div>
                </div>
                <span class="chart-col-label">Thu</span>
              </div>

              <!-- Fri: 3,450 (Hits: 2,580, Misses: 870) -->
              <div class="chart-col" data-day="Friday" data-total="3,450" data-hits="2,580" data-misses="870" data-rate="74.8%">
                <div class="chart-tooltip">
                  <strong>Friday</strong><br />
                  Total: 3,450<br />
                  Hits: 2,580 (74.8%)<br />
                  Misses: 870
                </div>
                <div class="chart-col-bars">
                  <div class="bar-stack" style="height: 86%;">
                    <div class="bar-segment-miss" style="height: 25%;"></div>
                    <div class="bar-segment-hit" style="height: 75%;"></div>
                  </div>
                </div>
                <span class="chart-col-label">Fri</span>
              </div>

              <!-- Sat: 4,020 (Hits: 3,015, Misses: 1,005) -->
              <div class="chart-col" data-day="Saturday" data-total="4,020" data-hits="3,015" data-misses="1,005" data-rate="75.0%">
                <div class="chart-tooltip">
                  <strong>Saturday</strong><br />
                  Total: 4,020<br />
                  Hits: 3,015 (75.0%)<br />
                  Misses: 1,005
                </div>
                <div class="chart-col-bars">
                  <div class="bar-stack" style="height: 100%;">
                    <div class="bar-segment-miss" style="height: 25%;"></div>
                    <div class="bar-segment-hit" style="height: 75%;"></div>
                  </div>
                </div>
                <span class="chart-col-label">Sat</span>
              </div>

              <!-- Sun: 3,421 (Hits: 2,538, Misses: 883) -->
              <div class="chart-col" data-day="Sunday" data-total="3,421" data-hits="2,538" data-misses="883" data-rate="74.2%">
                <div class="chart-tooltip">
                  <strong>Sunday</strong><br />
                  Total: 3,421<br />
                  Hits: 2,538 (74.2%)<br />
                  Misses: 883
                </div>
                <div class="chart-col-bars">
                  <div class="bar-stack" style="height: 85%;">
                    <div class="bar-segment-miss" style="height: 26%;"></div>
                    <div class="bar-segment-hit" style="height: 74%;"></div>
                  </div>
                </div>
                <span class="chart-col-label">Sun</span>
              </div>
            </div>
          </div>
        </section>

        <!-- API Key Quick Access Section (Mock Key) -->
        <section class="dash-panel" id="panel-api-keys">
          <div class="dash-panel-header">
            <div class="panel-header-title-group">
              <h3 class="dash-panel-title">API Keys</h3>
              <span class="mock-badge"><span class="mock-badge-dot"></span>Mock data</span>
            </div>
            <span class="dash-panel-badge">Project Scope</span>
          </div>

          <div class="api-key-item">
            <div class="api-key-header">
              <div class="api-key-name-group">
                <span class="api-key-name">Production</span>
                <span class="status-pill active">
                  <span class="status-pill-dot"></span>
                  <span>Active</span>
                </span>
              </div>
              <span style="font-size: 0.75rem; color: var(--text-muted);">Created 3d ago</span>
            </div>

            <!-- Mock Key Display Box -->
            <div class="api-key-val-box">
              <span class="api-key-val-text" id="api-key-display">pk_live_••••••••••••••••••••</span>
              <div class="api-key-actions">
                <button type="button" class="api-key-action-btn" id="btn-toggle-key" title="Toggle visibility">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path>
                    <circle cx="12" cy="12" r="3"></circle>
                  </svg>
                </button>
                <button type="button" class="api-key-action-btn" id="btn-copy-key" title="Copy API key">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
                    <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
                  </svg>
                </button>
              </div>
            </div>

            <button type="button" class="btn-manage-keys" id="btn-manage-keys">
              <span>Manage API Keys</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14"></path>
                <path d="m12 5 7 7-7 7"></path>
              </svg>
            </button>
          </div>
        </section>
      </div>

      <!-- Recent Requests Section (Realistic Mock Table) -->
      <section class="dash-panel-full" id="panel-recent-requests">
        <div class="dash-panel-header requests-panel-header">
          <div class="requests-header-title-group">
            <h3 class="dash-panel-title">Recent Requests</h3>
            <span class="mock-badge"><span class="mock-badge-dot"></span>Mock data</span>
          </div>
          <!-- Interactive Filter Pills -->
          <div class="requests-filter-pills" id="requests-filter">
            <button type="button" class="filter-pill active" data-filter="all">All (5)</button>
            <button type="button" class="filter-pill" data-filter="hit">Hits (3)</button>
            <button type="button" class="filter-pill" data-filter="miss">Misses (2)</button>
          </div>
        </div>

        <!-- Table with Responsive Scroll -->
        <div class="table-responsive">
          <table class="dash-table" id="table-recent-requests">
            <thead>
              <tr>
                <th scope="col">Request</th>
                <th scope="col">Model</th>
                <th scope="col">Cache</th>
                <th scope="col">Latency</th>
                <th scope="col">Time</th>
              </tr>
            </thead>
            <tbody id="requests-tbody">
              <!-- Row 1: HIT -->
              <tr data-status="hit">
                <td>
                  <div class="request-prompt-text" title="Explain recursion in JavaScript">
                    Explain recursion in JavaScript
                  </div>
                </td>
                <td>
                  <span class="badge-model">gpt-4o</span>
                </td>
                <td>
                  <span class="badge-cache-hit">
                    <span class="cache-dot-hit" aria-hidden="true"></span>
                    <span>HIT</span>
                  </span>
                </td>
                <td class="latency-cell">14ms</td>
                <td class="time-cell">2 min ago</td>
              </tr>

              <!-- Row 2: HIT -->
              <tr data-status="hit">
                <td>
                  <div class="request-prompt-text" title="Write a Python function to sort a list">
                    Write a Python function to sort a list
                  </div>
                </td>
                <td>
                  <span class="badge-model">gpt-4o-mini</span>
                </td>
                <td>
                  <span class="badge-cache-hit">
                    <span class="cache-dot-hit" aria-hidden="true"></span>
                    <span>HIT</span>
                  </span>
                </td>
                <td class="latency-cell">11ms</td>
                <td class="time-cell">8 min ago</td>
              </tr>

              <!-- Row 3: MISS -->
              <tr data-status="miss">
                <td>
                  <div class="request-prompt-text" title="Create a product description for a smartwatch">
                    Create a product description for a smartwatch
                  </div>
                </td>
                <td>
                  <span class="badge-model">gpt-4o</span>
                </td>
                <td>
                  <span class="badge-cache-miss">
                    <span class="cache-dot-miss" aria-hidden="true"></span>
                    <span>MISS</span>
                  </span>
                </td>
                <td class="latency-cell">842ms</td>
                <td class="time-cell">14 min ago</td>
              </tr>

              <!-- Row 4: HIT -->
              <tr data-status="hit">
                <td>
                  <div class="request-prompt-text" title="Explain MongoDB relationships">
                    Explain MongoDB relationships
                  </div>
                </td>
                <td>
                  <span class="badge-model">gpt-4o</span>
                </td>
                <td>
                  <span class="badge-cache-hit">
                    <span class="cache-dot-hit" aria-hidden="true"></span>
                    <span>HIT</span>
                  </span>
                </td>
                <td class="latency-cell">13ms</td>
                <td class="time-cell">21 min ago</td>
              </tr>

              <!-- Row 5: MISS -->
              <tr data-status="miss">
                <td>
                  <div class="request-prompt-text" title="Generate a landing page headline">
                    Generate a landing page headline
                  </div>
                </td>
                <td>
                  <span class="badge-model">gpt-4o-mini</span>
                </td>
                <td>
                  <span class="badge-cache-miss">
                    <span class="cache-dot-miss" aria-hidden="true"></span>
                    <span>MISS</span>
                  </span>
                </td>
                <td class="latency-cell">716ms</td>
                <td class="time-cell">34 min ago</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>
    </main>
  </div>


  <div class="modal-backdrop" id="modal-create-key" role="dialog" aria-modal="true" aria-labelledby="modal-key-title">
    <div class="modal-card">
      <div class="modal-header">
        <div class="modal-header-text">
          <h2 class="modal-title" id="modal-key-title">Create API Key</h2>
          <p class="modal-desc">Create a key for authenticating requests from your application.</p>
        </div>
        <button type="button" class="modal-close-btn" id="btn-close-modal" aria-label="Close dialog">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>

      <div class="modal-body">
        <div class="form-group">
          <label class="form-label" for="key-name-input">
            Key Name <span style="color: #ef4444;">*</span>
          </label>
          <input type="text" id="key-name-input" class="form-input" placeholder="e.g. Production" required />
          <span class="form-error-msg" id="key-name-error">Key Name is required</span>
        </div>

        <div class="form-group">
          <label class="form-label" for="key-project-select">
            Project <span style="color: #ef4444;">*</span>
          </label>
          <select id="key-project-select" class="form-select" required>
            <option value="" disabled selected>Select a project</option>
            <option value="MyQueryTool">MyQueryTool</option>
            <option value="AI Assistant">AI Assistant</option>
            <option value="Content Generator">Content Generator</option>
          </select>
          <span class="form-error-msg" id="key-project-error">Please select a project</span>
        </div>

        <div class="form-group">
          <label class="form-label" for="key-env-select">
            Environment <span style="color: #ef4444;">*</span>
          </label>
          <select id="key-env-select" class="form-select" required>
            <option value="" disabled selected>Select an environment</option>
            <option value="Production">Production</option>
            <option value="Development">Development</option>
          </select>
          <span class="form-error-msg" id="key-env-error">Please select an environment</span>
        </div>

        <!-- Newly Generated API Key Section (Suddenly shown on submit) -->
        <div class="form-group generated-key-group" id="generated-key-group" style="display: none;">
          <div style="display: flex; align-items: center; justify-content: space-between;">
            <label class="form-label" for="generated-key-input" style="color: #059669; font-weight: 700; display: flex; align-items: center; gap: 0.35rem;">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 2l-2 2m-1.5 1.5L16 7m-1.5 1.5L13 10m-1.5 1.5L10 13m-1.5 1.5L7 16m-1.5 1.5L4 19m-2 2l2-2m0 0l3-3m-3 3l3 3m13-17l-3-3m3 3l-3 3"></path>
                <circle cx="7.5" cy="16.5" r="3.5"></circle>
              </svg>
              <span>Your API Key</span>
            </label>
            <span style="font-size: 0.72rem; font-weight: 600; color: #059669; background: #ecfdf5; border: 1px solid #a7f3d0; padding: 0.15rem 0.45rem; border-radius: 4px;">Ready to copy</span>
          </div>
          <div class="generated-key-box">
            <input type="text" id="generated-key-input" class="generated-key-input" readonly value="" />
            <button type="button" class="btn-copy-generated" id="btn-copy-modal-key" title="Copy API key">
              <svg class="copy-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
                <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
              </svg>
              <span class="copy-label">Copy</span>
            </button>
          </div>
          <p style="margin: 0; font-size: 0.75rem; color: #059669; display: flex; align-items: center; gap: 0.35rem;">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
