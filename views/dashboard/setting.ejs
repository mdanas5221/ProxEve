<!doctype html>
<html lang="en">

<%- include('../partials/head.ejs') %>

<body class="dashboard-body">

  <div class="dash-mobile-backdrop" id="dash-mobile-backdrop" aria-hidden="true"></div>

  <%- include('../partials/sidebar.ejs') %>

  <div class="dash-main-container">

    <header class="dash-header" id="dash-header">
      <div class="dash-header-left">
        <button type="button" class="dash-sidebar-toggle-btn" id="dash-sidebar-toggle-btn" aria-label="Toggle sidebar" title="Toggle sidebar (Ctrl+B)">
          <svg class="icon-collapse" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="18" height="18" x="3" y="3" rx="2"></rect>
            <path d="M9 3v18"></path>
            <path d="m14 9-3 3 3 3"></path>
          </svg>
          <svg class="icon-expand" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="18" height="18" x="3" y="3" rx="2"></rect>
            <path d="M9 3v18"></path>
            <path d="m11 9 3 3-3 3"></path>
          </svg>
        </button>
        <div class="dash-header-title-group">
          <h1 class="dash-header-heading">Settings</h1>
          <p class="dash-header-subtitle">Manage your account, preferences, and project configuration.</p>
        </div>
      </div>

      <div class="dash-header-actions">
        <!-- Mobile Hamburger Toggle (Right-aligned) -->
        <button class="dash-mobile-toggle" id="dash-mobile-toggle" aria-label="Toggle dashboard menu" aria-expanded="false">
          <span class="hamburger-box">
            <span class="hamburger-line line-1"></span>
            <span class="hamburger-line line-2"></span>
            <span class="hamburger-line line-3"></span>
          </span>
        </button>
      </div>
    </header>

    <main class="dash-content">

      <section class="settings-toolbar" aria-label="Configuration Settings">
        <div class="toolbar-title-wrap">
          <span class="toolbar-title">General Preferences</span>
        </div>
      </section>

      <section class="settings-card" id="card-account" aria-label="Account Settings">
        <div class="settings-card-header">
          <div class="settings-card-title-group">
            <h2 class="settings-card-title">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path>
                <circle cx="12" cy="7" r="4"></circle>
              </svg>
              <span>Account</span>
            </h2>
            <p class="settings-card-desc">Your basic profile information and identity on ProxEve.</p>
          </div>
          <div style="display: flex; align-items: center; gap: 0.5rem;">
            <button type="button" class="btn-outline-action" id="btn-cancel-edit-account" style="display: none;">
              <span>Cancel</span>
            </button>
            <button type="button" class="btn-outline-action" id="btn-edit-account" aria-label="Edit account details">
              <svg id="icon-edit-account" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 20h9"></path>
                <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
              </svg>
              <span id="text-edit-account">Edit</span>
            </button>
          </div>
        </div>

        <div class="settings-card-body">
          <div class="settings-row">
            <div class="settings-field-info">
              <label class="settings-label" for="input-full-name">Full Name</label>
              <span class="settings-subtext">Used on invoices and notifications</span>
            </div>
            <div class="settings-value-box">
              <span class="field-display-text" id="display-full-name">Md Anas</span>
              <input type="text" class="settings-input" id="input-full-name" value="Md Anas" style="display: none;" autocomplete="name" placeholder="Full Name" />
            </div>
          </div>

          <div class="settings-row">
            <div class="settings-field-info">
              <label class="settings-label" for="input-email">Email</label>
              <span class="settings-subtext">Primary address for login and alerts</span>
            </div>
            <div class="settings-value-box">
              <span class="field-display-text" id="display-email">developer@example.com</span>
              <input type="email" class="settings-input" id="input-email" value="developer@example.com" style="display: none;" autocomplete="email" placeholder="Email address" />
            </div>
          </div>
        </div>
      </section>

      <section class="settings-card" id="card-security" aria-label="Security Settings">
        <div class="settings-card-header">
          <div class="settings-card-title-group">
            <h2 class="settings-card-title">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
              </svg>
              <span>Security</span>
            </h2>
            <p class="settings-card-desc">Manage your password and authentication verification.</p>
          </div>
        </div>

        <div class="settings-card-body">
          <div class="settings-row">
            <div class="settings-field-info">
              <span class="settings-label">Password</span>
              <span class="settings-subtext">Last updated 3 months ago</span>
            </div>
            <div class="settings-value-box">
              <span class="field-display-mono">••••••••••••</span>
              <button type="button" class="btn-outline-action" id="btn-change-password">
                <span>Change Password</span>
              </button>
            </div>
          </div>

          <div class="settings-row">
            <div class="settings-field-info">
              <span class="settings-label">Two-Factor Authentication</span>
              <span class="settings-subtext">Add an extra layer of security to your ProxEve account</span>
            </div>
            <div class="settings-value-box">
              <span class="status-tag-muted">Not enabled</span>
              <button type="button" class="btn-outline-action" id="btn-setup-2fa">
                <span>Set up</span>
              </button>
            </div>
          </div>
        </div>
      </section>


      <section class="settings-card" id="card-default-project" aria-label="Default Project Configuration">
        <div class="settings-card-header">
          <div class="settings-card-title-group">
            <h2 class="settings-card-title">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"></path>
              </svg>
              <span>Default Project</span>
            </h2>
            <p class="settings-card-desc">Choose the project shown by default when you open the dashboard.</p>
          </div>
        </div>

        <div class="settings-card-body">
          <div class="settings-row">
            <div class="settings-field-info">
              <span class="settings-label">Default Dashboard Project</span>
              <span class="settings-subtext">Applies to initial metrics, logs, and cache views</span>
            </div>
            <div class="settings-value-box">
              <select class="settings-select" id="select-default-project" aria-label="Select default dashboard project">
                <option value="MyQueryTool" selected>MyQueryTool</option>
                <option value="AI Assistant">AI Assistant</option>
                <option value="Content Generator">Content Generator</option>
              </select>
            </div>
          </div>
        </div>
      </section>

