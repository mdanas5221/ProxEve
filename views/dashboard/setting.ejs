      <!-- ==================================================
             6. API CONFIGURATION CARD
             ================================================== -->
      <section class="settings-card" id="card-api-config" aria-label="API Configuration Settings">
        <div class="settings-card-header">
          <div class="settings-card-title-group">
            <h2 class="settings-card-title">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="7.5" cy="15.5" r="5.5"></circle>
                <path d="m21 2-9.6 9.6"></path>
                <path d="m15.5 7.5 3 3L22 7l-3-3"></path>
              </svg>
              <span>API Configuration</span>
            </h2>
            <p class="settings-card-desc">Configure proxy defaults and connected provider targets.</p>
          </div>
        </div>

        <div class="settings-card-body">
          <div class="settings-row">
            <div class="settings-field-info">
              <span class="settings-label">Default API Environment</span>
              <span class="settings-subtext">Target environment used for new application routing</span>
            </div>
            <div class="settings-value-box">
              <select class="settings-select" id="select-default-env" aria-label="Default API Environment">
                <option value="Production" selected>Production</option>
                <option value="Development">Development</option>
              </select>
            </div>
          </div>

          <div class="settings-row">
            <div class="settings-field-info">
              <span class="settings-label">Default Provider</span>
              <span class="settings-subtext">Upstream AI model provider target</span>
            </div>
            <div class="settings-value-box">
              <select class="settings-select" id="select-default-provider" aria-label="Default AI Provider">
                <option value="OpenAI" selected>OpenAI</option>
              </select>
            </div>
          </div>

          <!-- Informational Security Note -->
          <div class="info-callout-box">
            <svg class="info-callout-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="16" x2="12" y2="12"></line>
              <line x1="12" y1="8" x2="12.01" y2="8"></line>
            </svg>
            <p class="info-callout-text">
              Provider API credentials are managed separately and should never be exposed in the dashboard UI.
            </p>
          </div>
        </div>
      </section>

      <!-- ==================================================
             7. DANGER ZONE
             ================================================== -->
      <section class="danger-zone-card" id="card-danger-zone" aria-label="Destructive Actions">
        <div class="danger-zone-header">
          <div class="settings-card-title-group">
            <h2 class="danger-zone-title">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"></path>
                <line x1="12" y1="9" x2="12" y2="13"></line>
                <line x1="12" y1="17" x2="12.01" y2="17"></line>
              </svg>
              <span>Danger Zone</span>
            </h2>
            <p class="settings-card-desc">Irreversible actions regarding your account and project data.</p>
          </div>
        </div>

        <div class="settings-card-body">
          <div class="settings-row">
            <div class="settings-field-info">
              <span class="settings-label" style="color: #991b1b;">Delete Account</span>
              <span class="settings-subtext">Permanently delete your ProxEve account and associated data.</span>
            </div>
            <div class="settings-value-box">
              <button type="button" class="btn-danger-action" id="btn-delete-account">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M3 6h18"></path>
                  <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path>
                  <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path>
                </svg>
                <span>Delete Account</span>
              </button>
            </div>
          </div>
        </div>
      </section>

      <!-- ==================================================
             8. SAVE ACTION AREA
             ================================================== -->
      <section class="bottom-action-bar" id="bottom-action-bar" aria-label="Save Settings Area">
        <div class="bottom-action-info">
          <span>Review your modifications before applying changes.</span>
        </div>
        <div class="bottom-action-buttons">
          <button type="button" class="btn-secondary-action" id="btn-cancel-settings">Cancel</button>
          <button type="button" class="btn-primary-save" id="btn-save-settings">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
              <polyline points="17 21 17 13 7 13 7 21"></polyline>
              <polyline points="7 3 7 8 15 8"></polyline>
            </svg>
            <span>Save Changes</span>
          </button>
        </div>
      </section>
    </main>
  </div>

  <%- include('../partials/toast-msg.ejs') %>

  <%- include('../partials/footer.ejs') %>
</body>

</html>