<!DOCTYPE html>
<html lang="en">

<%- include('../partials/head.ejs') %>

<body class="auth-page">

  <%- include('../partials/navbar.ejs') %>

  <!-- Centered Card Container with Ambient Glow -->
  <div class="auth-card-container">
    <div class="auth-card-glow" aria-hidden="true"></div>

    <main class="auth-card" id="login-card">
      <!-- Modern Logo & Wordmark -->
      <div class="auth-logo-wrapper">
        <a href="/" class="auth-logo-link" id="auth-logo" aria-label="ProxEve Home">
          <span class="auth-logo-mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="3" width="8" height="8" rx="2"></rect>
              <rect x="14" y="3" width="8" height="8" rx="2"></rect>
              <rect x="8" y="13" width="8" height="8" rx="2"></rect>
              <path d="M6 11v4a2 2 0 0 0 2 2h2"></path>
              <path d="M18 11v4a2 2 0 0 1-2 2h-2"></path>
            </svg>
          </span>
          <span>ProxEve</span>
        </a>
      </div>

      <!-- Heading & Subheading -->
      <div class="auth-header">
        <h1 class="auth-title">Welcome back</h1>
        <p class="auth-subtitle">Sign in to your ProxEve account.</p>
      </div>

      <!-- Modern Login Form Structure -->
      <form class="auth-form" id="login-form" action="/api/auth/signin" method="POST">
        <!-- Email Field with Icon -->
        <div class="auth-form-group">
          <label for="login-email" class="auth-label">Email address</label>
          <div class="auth-input-container">
            <span class="auth-input-icon" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
              </svg>
            </span>
            <input type="email" id="login-email" name="email" class="auth-input no-action-icon" placeholder="you@example.com" required autocomplete="email" />
          </div>
        </div>

        <div class="auth-form-group">
          <div class="auth-label-row">
            <label for="login-password" class="auth-label">Password</label>
          </div>
          <div class="auth-input-container">
            <span class="auth-input-icon" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
              </svg>
            </span>
            <input type="password" id="login-password" name="password" class="auth-input" placeholder="Enter your password" required autocomplete="current-password" />
            <button type="button" class="auth-password-toggle" id="toggle-password-visibility" aria-label="Toggle password visibility">
              
              <svg class="icon-eye" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path>
                <circle cx="12" cy="12" r="3"></circle>
              </svg>
        
              <svg class="icon-eye-off" style="display: none;" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"></path>
                <path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"></path>
                <path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"></path>
                <line x1="2" y1="2" x2="22" y2="22"></line>
              </svg>
            </button>
          </div>
        </div>


        <!-- Primary Submit Button -->
        <button type="submit" class="auth-submit-btn" id="btn-login-submit">
          <span>Sign in</span>
          <svg class="btn-arrow-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </button>
      </form>

      <!-- Bottom Account Registration Prompt -->
      <div class="auth-footer-prompt">
        <span>Don't have an account?</span>
        <a href="/signup" class="auth-footer-link" id="link-create-account">Create account</a>
      </div>
    </main>

    <!-- Security / Encryption note -->
    <div class="auth-security-note">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
      </svg>
      <span>End-to-end encrypted connection</span>
    </div>
  </div>

  <%- include('../partials/footer.ejs') %>

</body>

</html>