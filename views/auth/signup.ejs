<!doctype html>
<html lang="en">

<%- include('../partials/head.ejs') %>

<body class="auth-page">

  <%- include('../partials/navbar.ejs') %>

  <!-- Centered Card Container with Ambient Glow -->
  <div class="auth-card-container">
    <div class="auth-card-glow" aria-hidden="true"></div>

    <main class="auth-card" id="signup-card">
      <!-- Modern Logo & Wordmark -->
      <div class="auth-logo-wrapper">
        <a href="/" class="auth-logo-link" id="auth-logo" aria-label="ProxEve Home">
          <span class="auth-logo-mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="3" width="8" height="8" rx="2"></rect>
              <rect x="14" y="3" width="8" height="8" rx="2"></rect>
              <rect x="8" y="13" width="8" height="8" rx="2"></rect>
              <path d="M6 11v4a2 2 0 0 0 2 2h2"></path>
              <path d="M18 11v4a2 2 0 0 1-2 2h-2"></path>
            </svg>
          </span>
          <span>ProxEve</span>
        </a>
      </div>

      <!-- Heading & Subheading -->
      <div class="auth-header">
        <h1 class="auth-title">Create your account</h1>
        <p class="auth-subtitle">Start caching AI API requests with zero latency penalty.</p>
      </div>

      <!-- Modern Signup Form Structure -->
      <form class="auth-form" id="signup-form" action="/api/auth/signup" method="POST">
        <!-- Full Name Field with Icon -->
        <div class="auth-form-group">
          <label for="signup-name" class="auth-label">Full name</label>
          <div class="auth-input-container">
            <span class="auth-input-icon" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path>
                <circle cx="12" cy="7" r="4"></circle>
              </svg>
            </span>
            <input type="text" id="signup-name" name="name" class="auth-input no-action-icon" placeholder="Ada Lovelace" required autocomplete="name" />
          </div>
        </div>

        <!-- Email Field with Icon -->
        <div class="auth-form-group">
          <label for="signup-email" class="auth-label">Work email</label>
          <div class="auth-input-container">
            <span class="auth-input-icon" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
              </svg>
            </span>
            <input type="email" id="signup-email" name="email" class="auth-input no-action-icon" placeholder="you@company.com" required autocomplete="email" />
          </div>
        </div>

        <!-- Password Field with Icon and Toggle -->
        <div class="auth-form-group">
          <div class="auth-label-row">
            <label for="signup-password" class="auth-label">Password</label>
            <span class="auth-label-hint">Min. 8 chars</span>
          </div>
          <div class="auth-input-container">
            <span class="auth-input-icon" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
              </svg>
            </span>
            <input type="password" id="signup-password" name="password" class="auth-input" placeholder="Create a secure password" required minlength="8" autocomplete="new-password" />
            <button type="button" class="auth-password-toggle" id="toggle-signup-password" aria-label="Toggle password visibility">
              <!-- Eye Icon (default) -->
              <svg class="icon-eye" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path>
                <circle cx="12" cy="12" r="3"></circle>
              </svg>
              <!-- Eye Off Icon (hidden initially) -->
              <svg class="icon-eye-off" style="display: none;" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"></path>
                <path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"></path>
                <path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"></path>
                <line x1="2" y1="2" x2="22" y2="22"></line>
              </svg>
            </button>
          </div>
        </div>

        <!-- Terms of service checkbox -->
        <div class="auth-terms-row">
          <input type="checkbox" class="auth-checkbox" id="signup-terms" name="terms" required />
          <label for="signup-terms" class="auth-terms-text">
            I agree to the <a href="#" class="auth-terms-link">Terms of Service</a> and <a href="#" class="auth-terms-link">Privacy Policy</a>.
          </label>
        </div>

        <!-- Primary Submit Button -->
        <button type="submit" class="auth-submit-btn" id="btn-signup-submit">
          <span>Create account</span>
          <svg class="btn-arrow-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </button>
      </form>

      <!-- Bottom Switch to Login Prompt -->
      <div class="auth-footer-prompt">
        <span>Already have an account?</span>
        <a href="/signin" class="auth-footer-link" id="link-sign-in">Sign in</a>
      </div>
    </main>

    <!-- Security / Encryption note -->
    <div class="auth-security-note">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
      </svg>
      <span>End-to-end encrypted connection</span>
    </div>
  </div>

  <%- include('../partials/footer.ejs') %>
</body>

</html>