 <div class="modal-backdrop" id="modal-create-key" role="dialog" aria-modal="true" aria-labelledby="modal-key-title">
   <div class="modal-card">
     <div class="modal-header">
       <div class="modal-header-text">
         <h2 class="modal-title" id="modal-key-title">Create API Key</h2>
         <p class="modal-desc">Create a key for authenticating requests from your application.</p>
       </div>
       <button type="button" class="modal-close-btn" id="btn-close-modal" aria-label="Close dialog">
         <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
           <line x1="18" y1="6" x2="6" y2="18"></line>
           <line x1="6" y1="6" x2="18" y2="18"></line>
         </svg>
       </button>
     </div>

     <div class="modal-body">
       <div class="form-group">
         <label class="form-label" for="key-name-input">
           Key Name <span style="color: #ef4444;">*</span>
         </label>
         <input type="text" id="key-name-input" class="form-input" placeholder="e.g. Production" required />
         <span class="form-error-msg" id="key-name-error">Key Name is required</span>
       </div>

       <div class="form-group">
         <label class="form-label" for="key-project-select">
           Project <span style="color: #ef4444;">*</span>
         </label>
         <select id="key-project-select" class="form-select" required>
           <option value="" disabled selected>Select a project</option>
           <option value="MyQueryTool">MyQueryTool</option>
           <option value="AI Assistant">AI Assistant</option>
           <option value="Content Generator">Content Generator</option>
         </select>
         <span class="form-error-msg" id="key-project-error">Please select a project</span>
       </div>

       <div class="form-group">
         <label class="form-label" for="key-env-select">
           Environment <span style="color: #ef4444;">*</span>
         </label>
         <select id="key-env-select" class="form-select" required>
           <option value="" disabled selected>Select an environment</option>
           <option value="Production">Production</option>
           <option value="Development">Development</option>
         </select>
         <span class="form-error-msg" id="key-env-error">Please select an environment</span>
       </div>

       <!-- Newly Generated API Key Section (Suddenly shown on submit) -->
       <div class="form-group generated-key-group" id="generated-key-group" style="display: none;">
         <div style="display: flex; align-items: center; justify-content: space-between;">
           <label class="form-label" for="generated-key-input" style="color: #059669; font-weight: 700; display: flex; align-items: center; gap: 0.35rem;">
             <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
               <path d="M21 2l-2 2m-1.5 1.5L16 7m-1.5 1.5L13 10m-1.5 1.5L10 13m-1.5 1.5L7 16m-1.5 1.5L4 19m-2 2l2-2m0 0l3-3m-3 3l3 3m13-17l-3-3m3 3l-3 3"></path>
               <circle cx="7.5" cy="16.5" r="3.5"></circle>
             </svg>
             <span>Your API Key</span>
           </label>
           <span style="font-size: 0.72rem; font-weight: 600; color: #059669; background: #ecfdf5; border: 1px solid #a7f3d0; padding: 0.15rem 0.45rem; border-radius: 4px;">Ready to copy</span>
         </div>
         <div class="generated-key-box">
           <input type="text" id="generated-key-input" class="generated-key-input" readonly value="" />
           <button type="button" class="btn-copy-generated" id="btn-copy-modal-key" title="Copy API key">
             <svg class="copy-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
               <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
               <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
             </svg>
             <span class="copy-label">Copy</span>
           </button>
         </div>
         <p style="margin: 0; font-size: 0.75rem; color: #059669; display: flex; align-items: center; gap: 0.35rem;">
           <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
             <polyline points="20 6 9 17 4 12"></polyline>
           </svg>
           Copy this key now. It won't be shown again.
         </p>
       </div>

       <!-- Security One-Time Display Callout Notice -->
       <div class="modal-security-callout">
         <svg class="callout-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
           <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
           <line x1="12" y1="9" x2="12" y2="13"></line>
           <line x1="12" y1="17" x2="12.01" y2="17"></line>
         </svg>
         <p class="callout-text">
           <strong>Security Notice:</strong> Your API key will only be shown once. Store it securely.
         </p>
       </div>
     </div>

     <div class="modal-footer">
       <button type="button" class="btn-modal-cancel" id="btn-modal-cancel">Cancel</button>
       <button type="button" class="btn-modal-submit" id="btn-submit-modal">Create API Key</button>
     </div>
   </div>
 </div>