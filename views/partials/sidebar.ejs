 <aside class="dash-sidebar" id="dash-sidebar" aria-label="Dashboard Sidebar">
   <div class="sidebar-top">
     <!-- Logo & Close Row -->
     <div class="sidebar-brand-row">
       <a href="/" class="sidebar-brand" id="sidebar-logo" aria-label="ProxEve Home">
         <span class="sidebar-logo-mark" aria-hidden="true">
           <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
             <rect x="2" y="3" width="8" height="8" rx="2"></rect>
             <rect x="14" y="3" width="8" height="8" rx="2"></rect>
             <rect x="8" y="13" width="8" height="8" rx="2"></rect>
             <path d="M6 11v4a2 2 0 0 0 2 2h2"></path>
             <path d="M18 11v4a2 2 0 0 1-2 2h-2"></path>
           </svg>
         </span>
         <span>ProxEve</span>
       </a>
       <button class="sidebar-close-btn" id="sidebar-close-btn" aria-label="Close sidebar menu">
         <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
           <line x1="18" y1="6" x2="6" y2="18"></line>
           <line x1="6" y1="6" x2="18" y2="18"></line>
         </svg>
       </button>
     </div>

     <!-- Project Selector Dropdown in Sidebar -->
     <div class="project-selector-dropdown-wrap sidebar-project-wrap" id="project-selector-wrap">
       <div class="sidebar-project-caption">Project Workspace</div>
       <button type="button" class="project-selector-btn" id="btn-project-selector" aria-haspopup="true" aria-expanded="false" title="Switch project">
         <span class="project-selector-name" id="selected-project-name">
           <span class="project-dot" aria-hidden="true"></span>
           <span id="current-project-display">fgh</span>
         </span>
         <svg class="project-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
           <path d="m6 9 6 6 6-6"></path>
         </svg>
       </button>
       <div class="project-dropdown-menu" id="menu-project-selector" role="menu">
         <button type="button" class="project-menu-item selected" data-value="my-project" role="menuitem">
           <div class="project-item-info">
             <span class="project-dot" aria-hidden="true"></span>
             <span class="project-item-name">Eve</span>
           </div>
           <svg class="project-item-check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
             <polyline points="20 6 9 17 4 12"></polyline>
           </svg>
         </button>
        
         <div class="project-dropdown-divider"></div>
         <button type="button" class="project-menu-item project-menu-action" id="dropdown-btn-create-project" role="menuitem">
           <div class="project-item-info">
             <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
               <line x1="12" y1="5" x2="12" y2="19"></line>
               <line x1="5" y1="12" x2="19" y2="12"></line>
             </svg>
             <span>Create Project</span>
           </div>
         </button>
       </div>
     </div>

     <!-- Main Navigation Links -->
     <ul class="sidebar-nav" role="menu">
       <li class="sidebar-nav-item" role="none">
         <a href="/dashboard/overview" class="sidebar-nav-link" id="nav-item-overview" data-title="Overview" title="Overview" role="menuitem">
           <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
             <rect width="7" height="9" x="3" y="3" rx="1"></rect>
             <rect width="7" height="5" x="14" y="3" rx="1"></rect>
             <rect width="7" height="9" x="14" y="12" rx="1"></rect>
             <rect width="7" height="5" x="3" y="16" rx="1"></rect>
           </svg>
           <span>Overview</span>
         </a>
       </li>
       <li class="sidebar-nav-item" role="none">
         <a href="/dashboard/projects" class="sidebar-nav-link" id="nav-item-projects" data-title="Projects" title="Projects" role="menuitem">
           <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
             <path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"></path>
           </svg>
           <span>Projects</span>
         </a>
       </li>
       <li class="sidebar-nav-item" role="none">
         <a href="/dashboard/api-keys" class="sidebar-nav-link" id="nav-item-keys" data-title="API Keys" title="API Keys" role="menuitem">
           <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
             <circle cx="7.5" cy="15.5" r="5.5"></circle>
             <path d="m21 2-9.6 9.6"></path>
             <path d="m15.5 7.5 3 3L22 7l-3-3"></path>
           </svg>
           <span>API Keys</span>
         </a>
       </li>
       <li class="sidebar-nav-item" role="none">
         <a href="/dashboard/usage" class="sidebar-nav-link" id="nav-item-usage" data-title="Usage" title="Usage" role="menuitem">
           <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
             <line x1="12" x2="12" y1="20" y2="10"></line>
             <line x1="18" x2="18" y1="20" y2="4"></line>
             <line x1="6" x2="6" y1="20" y2="16"></line>
           </svg>
           <span>Usage</span>
         </a>
       </li>
       <li class="sidebar-nav-item" role="none">
         <a href="/dashboard/settings" class="sidebar-nav-link" id="nav-item-settings" data-title="Settings" title="Settings" role="menuitem">
           <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
             <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"></path>
             <circle cx="12" cy="12" r="3"></circle>
           </svg>
           <span>Settings</span>
         </a>
       </li>
       <li class="sidebar-nav-item" role="none">
         <a href="/dashboard/documentation" class="sidebar-nav-link" id="nav-item-docs" data-title="Documentation" title="Documentation" role="menuitem">
           <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
             <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
             <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
           </svg>
           <span>Documentation</span>
         </a>
       </li>
     </ul>
   </div>

   <!-- Bottom User Profile -->
   <div class="sidebar-bottom">
     <div class="sidebar-user">
       <div class="user-info-group">
         <div class="user-avatar" aria-hidden="true"><%= user.name.slice(0, 2).toUpperCase() %></div>
         <div class="user-details">
           <span class="user-name"><%= user.name %></span>
           <span class="user-email"><%= user.email %></span>
         </div>
       </div>
       <form action="/logout" method="POST">
         <button class="user-logout-btn" id="btn-logout" title="Log out" aria-label="Log out">
           <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
             <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
             <polyline points="16 17 21 12 16 7"></polyline>
             <line x1="21" x2="9" y1="12" y2="12"></line>
           </svg>
         </button>
       </form>
     </div>
   </div>
 </aside>